// =====================================================================
// LAPISAN DATABASE — SUPABASE (pengganti Firestore)
// API-nya SENGAJA dibuat sama persis dengan versi Firebase, jadi seluruh
// kode aplikasi (App.jsx, Inventory.jsx, dll) tidak perlu diubah.
//
// Bentuk baris: { id: 'abc', data: {...isi dokumen...} }
// Fungsi di sini mengembalikannya sebagai { id, ...data } — sama seperti dulu.
// =====================================================================
import { supabase, tabel } from './supabase'

// =============================================
// STATUS KONEKSI (banner peringatan di aplikasi)
// =============================================
let dbErrorHandler = null
export function onDbError(fn) { dbErrorHandler = fn }
export function reportDbError(err, konteks) {
  const msg = err?.message || String(err || '')
  let pesan = 'Gangguan koneksi ke server (' + (konteks || 'data') + ')'
  if (/Failed to fetch|NetworkError|network/i.test(msg)) pesan = 'Server tidak terjangkau — periksa koneksi internet. Data belum tersimpan.'
  else if (/JWT|permission|denied|row-level/i.test(msg)) pesan = 'Ditolak server (izin database) — data TIDAK tersimpan.'
  else if (msg) pesan = 'Gagal ' + (konteks || 'menyimpan') + ': ' + msg
  console.error('[DB ERROR]', konteks, err)
  if (dbErrorHandler) dbErrorHandler(pesan)
}

function baris(r) { return { id: r.id, ...(r.data || {}) } }

// Buang field id dari isi dokumen (id disimpan di kolom sendiri)
function isi(data) {
  const { id, ...sisa } = data || {}
  return sisa
}

// =============================================
// PENTING — BATAS 1000 BARIS
// Supabase (PostgREST) diam-diam memotong hasil di 1000 baris.
// Tanpa penanganan ini, koleksi besar seperti transactions (ribuan nota)
// hanya terbaca 1000 saja → Laba Rugi, SHU, riwayat penjualan, dan
// backup semuanya jadi salah TANPA pesan error apa pun.
// Solusinya: ambil bertahap 1000-1000 sampai habis.
// =============================================
const HAL = 1000

async function ambilSemuaBaris(namaTabel, kolom) {
  const kumpulan = []
  let dari = 0
  for (;;) {
    const { data, error } = await supabase
      .from(namaTabel)
      .select(kolom || 'id,data')
      .range(dari, dari + HAL - 1)
    if (error) throw error
    const potongan = data || []
    kumpulan.push(...potongan)
    if (potongan.length < HAL) break     // sudah habis
    dari += HAL
    if (dari > 500000) break             // pengaman, jangan sampai tak berujung
  }
  return kumpulan
}

// =============================================
// GENERIC CRUD
// =============================================
export async function getAll(col) {
  try {
    const data = await ambilSemuaBaris(tabel(col))
    return data.map(baris)
  } catch (error) { reportDbError(error, 'baca ' + col); throw error }
}

export async function getOne(col, id) {
  const { data, error } = await supabase.from(tabel(col)).select('id,data').eq('id', id).maybeSingle()
  if (error) { reportDbError(error, 'baca ' + col); throw error }
  return data ? baris(data) : null
}

// setOne = simpan-GABUNG (merge), sama seperti setDoc(..., {merge:true}).
// Hanya field yang dikirim yang berubah — penting supaya update harga
// tidak menimpa stok, dan sebaliknya.
export async function setOne(col, id, data) {
  const { error } = await supabase.rpc('set_merge', {
    tbl: tabel(col), row_id: String(id), patch: isi(data),
  })
  if (error) { reportDbError(error, 'simpan ' + col); throw error }
}

export async function addOne(col, data) {
  const id = genId()
  await setOne(col, id, { ...data, id })
  return id
}

export async function removeOne(col, id) {
  const { error } = await supabase.from(tabel(col)).delete().eq('id', String(id))
  if (error) { reportDbError(error, 'hapus ' + col); throw error }
}

// Tambah/kurangi field angka secara ATOMIK di server.
// Kebal race condition: dua kasir jualan bersamaan tidak saling menimpa.
export async function incField(col, id, field, delta, extra) {
  const { error } = await supabase.rpc('inc_field', {
    tbl: tabel(col), row_id: String(id), field, delta: Number(delta) || 0, extra: extra || {},
  })
  if (error) { reportDbError(error, 'update ' + field); throw error }
}

// =============================================
// BATCH WRITE (import massal)
// =============================================
export async function batchSet(col, items, onProgress) {
  const BATCH_SIZE = 500
  let done = 0
  for (let i = 0; i < items.length; i += BATCH_SIZE) {
    const chunk = items.slice(i, i + BATCH_SIZE)
    const rows = chunk.map(item => {
      const itemId = item.id || genId()
      item.id = itemId
      return { id: String(itemId), data: isi(item), updated_at: new Date().toISOString() }
    })
    const { error } = await supabase.from(tabel(col)).upsert(rows, { onConflict: 'id' })
    if (error) { reportDbError(error, 'import ' + col); throw error }
    done += chunk.length
    if (onProgress) onProgress(done, items.length)
  }
  return done
}

// =============================================
// REALTIME LISTENER
// Ambil sekali di awal, lalu ikuti perubahan (insert/update/delete).
// TIDAK ada batas baca harian di Supabase — inilah alasan pindah ke sini.
// =============================================
function pasangRealtime(col, ambilUlang, peta, kirim) {
  const namaTabel = tabel(col)
  const channel = supabase
    .channel('rt_' + namaTabel + '_' + Math.random().toString(36).slice(2, 8))
    .on('postgres_changes', { event: '*', schema: 'public', table: namaTabel }, (payload) => {
      try {
        if (payload.eventType === 'DELETE') {
          const id = payload.old?.id
          if (id != null) peta.delete(id)
        } else {
          const row = payload.new
          if (row?.id != null) peta.set(row.id, baris(row))
        }
        kirim()
      } catch (err) { console.error('Realtime handler error [' + col + ']:', err) }
    })
    .subscribe((status) => {
      // Kalau koneksi realtime sempat putus lalu tersambung lagi,
      // ambil ulang data supaya tidak ada perubahan yang terlewat.
      if (status === 'SUBSCRIBED') ambilUlang()
    })
  return channel
}

export function listenCollection(col, callback) {
  const peta = new Map()
  let hidup = true
  const kirim = () => { if (hidup) callback(Array.from(peta.values())) }

  async function ambilUlang() {
    try {
      const data = await ambilSemuaBaris(tabel(col))
      if (!hidup) return
      peta.clear()
      for (const r of data) peta.set(r.id, baris(r))
      kirim()
    } catch (err) {
      // Jangan kosongkan data lama saat error — biarkan layar tetap terisi
      reportDbError(err, 'baca ' + col)
    }
  }

  ambilUlang()
  const channel = pasangRealtime(col, ambilUlang, peta, kirim)
  return () => { hidup = false; try { supabase.removeChannel(channel) } catch {} }
}

// Versi hemat: hanya N dokumen terbaru (dipakai untuk auditLogs)
export function listenCollectionRecent(col, callback, orderField, n) {
  const peta = new Map()
  let hidup = true
  const kirim = () => { if (hidup) callback(Array.from(peta.values())) }

  async function ambilUlang() {
    try {
      const { data, error } = await supabase.from(tabel(col))
        .select('id,data')
        .order('data->>' + orderField, { ascending: false })
        .limit(n)
      if (error) throw error
      if (!hidup) return
      peta.clear()
      for (const r of (data || [])) peta.set(r.id, baris(r))
      kirim()
    } catch (err) { reportDbError(err, 'baca ' + col) }
  }

  ambilUlang()
  const channel = pasangRealtime(col, ambilUlang, peta, kirim)
  return () => { hidup = false; try { supabase.removeChannel(channel) } catch {} }
}

// =============================================
// DELETE COLLECTION (untuk reset data)
// =============================================
export async function deleteCollection(col, onProgress) {
  let semua
  try { semua = await ambilSemuaBaris(tabel(col), 'id') }
  catch (error) { reportDbError(error, 'baca ' + col); throw error }
  const ids = semua.map(r => r.id)
  if (ids.length === 0) return 0
  const BATCH = 500
  let done = 0
  for (let i = 0; i < ids.length; i += BATCH) {
    const chunk = ids.slice(i, i + BATCH)
    const { error: err2 } = await supabase.from(tabel(col)).delete().in('id', chunk)
    if (err2) { reportDbError(err2, 'hapus ' + col); throw err2 }
    done += chunk.length
    if (onProgress) onProgress(done, ids.length)
  }
  return done
}

// =============================================
// HELPERS
// =============================================
function genId() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 7)
}

// =============================================
// SEED AWAL (hanya untuk database yang benar-benar kosong)
// CATATAN PERUBAHAN: versi Firestore lama juga menyuntik data CONTOH
// (anggota & produk fiktif). Itu berbahaya untuk koperasi sungguhan,
// jadi di sini HANYA user login + pengaturan dasar yang dibuat.
// =============================================
export async function seedIfEmpty() {
  try { if (localStorage.getItem('koperasi_seeded') === '1') return false } catch {}

  const { data, error } = await supabase.from('users').select('id').limit(1)
  if (error) { reportDbError(error, 'cek users'); return false }
  if (data && data.length > 0) {
    try { localStorage.setItem('koperasi_seeded', '1') } catch {}
    return false
  }

  await batchSet('users', [
    { id: 'u1', username: 'admin', password: 'admin123', name: 'Administrator', role: 'admin' },
    { id: 'u2', username: 'bendahara', password: 'bend123', name: 'Bendahara', role: 'bendahara' },
    { id: 'u3', username: 'ketua', password: 'ketua123', name: 'Ketua Koperasi', role: 'ketua' },
  ])
  await setOne('settings', 'main', {
    name: 'KOPERASI YONIF 527/BY',
    simpPokok: 500000, simpWajib: 100000,
    bungaPinjaman: 1.5, maxPinjaman: 10000000, kasPin: '527',
  })
  try { localStorage.setItem('koperasi_seeded', '1') } catch {}
  return true
}

// Dipertahankan agar impor di App.jsx tetap jalan.
// Sengaja TIDAK menyuntik produk contoh — stok diisi lewat menu Barang Masuk.
export async function seedInventoryIfEmpty() {
  return false
}
